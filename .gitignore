# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pytest_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
*.env

# Large Datasets (preserve .gitkeep)
data/raw/*.csv
data/raw/*.zip
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model Artifacts (preserve .gitkeep)
models/*.joblib
models/*.pt
models/*.pth
models/*.pkl
models/*.onnx
!models/.gitkeep

# IDEs & OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs & temp
*.log
streamlit.log
screenshots/
